{
  "manifest_version": 3,
  "name": "LinkedIn AI Autonomous Agent",
  "version": "1.0.0",
  "description": "Enterprise local-first AI job automation and resume tailoring agent.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn AI Agent"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/jobs/*",
        "https://*.linkedin.com/feed/*",
        "https://*.linkedin.com/my-items/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
